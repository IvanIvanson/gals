# Нормализуем line endings: в репозитории всегда LF, на диске всегда LF.
# Без этого core.autocrlf=true на Windows превратит все LF в CRLF при checkout.
#
# Если после добавления этого файла git ругается "LF will be replaced by CRLF",
# выполните:  git add --renormalize .
* text=auto eol=lf

# Исходники документации
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# Минифицированные CDN-файлы — не трогать вообще: git не будет
# конвертировать line endings и не будет считать их «текстовыми».
cdn/*.min.css  -text
cdn/*.min.js   -text
gals-main/cdn/*.min.css  -text
gals-main/cdn/*.min.js   -text

# Source maps — тоже не конвертировать (не критично, но чище)
*.css.map -text
*.js.map  -text

# Бинарники
*.zip  -text -diff
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.ico  -text
*.webp -text
*.woff -text
*.woff2 -text
*.pdf  -text
